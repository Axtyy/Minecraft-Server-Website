{
  "name": "minecraft-server-website",
  "version": "1.0.0",
  "description": "Minecraft server website: a Tebex Headless store, stats, vote, rules and punishments pages, rendered server-side",
  "main": "server.js",
  "scripts": {
    "init": "node scripts/init-db.js",
    "build": "vite build",
    "start": "node server.js",
    "dev": "node scripts/dev.js",
    "dev:api": "node --watch server.js",
    "dev:web": "vite build --watch",
    "demo": "vite build && node server.js --demo"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0"
  },
  "license": "MIT"
}
