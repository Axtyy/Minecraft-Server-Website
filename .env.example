# Copy to .env and fill in. .env is gitignored; never commit real secrets.

# ---------------------------------------------------------------------- tebex
# Headless API. Tebex → your project → Settings → API Keys.
#
# The PUBLIC token identifies the storefront. Tebex documents it as safe for a
# browser; this store keeps it server-side anyway, so it cannot be lifted from
# a page and used to spend our rate limit from somewhere else.
TEBEX_PUBLIC_TOKEN=

# The SECRET key is full authority over the classic API — customer data and
# refunds. Never let it reach a browser.
#
# Headless uses it for one thing: HTTP Basic auth on basket creation, which is
# what Tebex requires before it will accept a customer's IP from a server. Leave
# it blank and the store still works, but every basket is recorded against this
# machine's address, so Tebex geolocates every customer to wherever this server
# is — and that drives tax and currency. The server warns at startup if it is
# missing.
TEBEX_SECRET_KEY=

TEBEX_TIMEOUT_MS=8000

# --------------------------------------------------------------------- store
# The address buyers reach this store on. Tebex sends them back here after
# checkout, so it must be the real public URL — it is deliberately NOT taken
# from the request's Host header, which anyone who can reach the service could
# set to redirect completion wherever they liked.
STORE_PUBLIC_URL=https://store.example.net

# Everything that is not the store. The two live on different hostnames, so the
# nav needs both to point each tab at the right one; blank falls back to plain
# relative links, which is what a single-hostname install wants.
SITE_PUBLIC_URL=https://example.net

STORE_NAME=My Server
# Where the terms and privacy pages tell buyers to write to.
STORE_CONTACT_EMAIL=

# Category slugs the store never shows, comma-separated (e.g. crates,bundles).
STORE_HIDDEN_CATEGORIES=

# The logo in the banner, as a URL or a path under public/. Blank uses
# public/assets/img/logo.webp, or the neutral logo.svg when there is none.
STORE_LOGO=
# Shown small in the footer, e.g. a company name and registration.
STORE_LEGAL=

# The promo band across the top. Leave the title blank to hide it entirely.
#
# Headless has no endpoint for a store-wide sale — that setting lives in the
# Tebex panel only. So the band is display text here, and the discount itself
# is a Tebex coupon applied at checkout. Nothing about the price is decided by
# anything the browser can see.
STORE_PROMO_TITLE=
STORE_PROMO_BODY=
STORE_PROMO_CODE=
# The look. STORE_SKIN: graphite (grey, the default) or sky (daytime sky
# with clouds; a starry night sky in dark mode). STORE_ACCENT: blue (the
# default), ember or gem. Visitors still choose light or dark themselves.
STORE_SKIN=
STORE_ACCENT=

# ISO code used to format prices in the page. Leave blank to use Tebex's.
STORE_CURRENCY=

PORT=3100

# How long the catalogue is reused before asking Tebex again.
STORE_CACHE_MS=60000

# How long a browser session (and therefore a basket) survives.
STORE_SESSION_HOURS=24

# Set true when serving over HTTPS, so the session cookie is marked Secure.
COOKIE_SECURE=false

# Set true only when behind a reverse proxy you control, so cf-connecting-ip
# and X-Forwarded-For are trusted. Setting it true when NOT behind one lets
# anyone spoof their IP.
#
# Leaving it false behind a proxy is not merely a lost rate-limit bucket: every
# request then looks like it came from the proxy, which is localhost. Tebex is
# sent that as the buyer's address, ignores it as private, and falls back to
# geolocating this server — so every customer in the world is quoted this
# machine's country, currency and tax rate.
TRUST_PROXY=false

# ------------------------------------------------------------------ database
# The same MariaDB the rest of the network uses. On VPS 1 this is local.
STORE_DB_HOST=127.0.0.1
STORE_DB_PORT=3306
STORE_DB_USER=solar
STORE_DB_PASSWORD=
STORE_DB_NAME=solar
STORE_DB_POOL=4

# Or as one URL, which overrides the five above:
# STORE_DB_URL=mysql://solar:password@127.0.0.1:3306/solar

# The address people connect to. Shown under the logo in the header with a
# copy button; leave blank and that line is not rendered at all.
STORE_SERVER_IP=

# The live player count beside that address.
#
# The site pings the server itself, the same way the game client does, so no
# third-party status API is involved. By default it pings STORE_SERVER_IP,
# following its SRV record if it has one — set STORE_STATUS_HOST only when the
# printed address is not the one this process can reach (an internal hostname,
# a container network). host:port is accepted in either variable.
#
# An address that has never answered shows as a plain address with no count,
# never as OFFLINE: not being able to reach the server from here is usually a
# fact about this container's network and not about the server.
STORE_STATUS_HOST=
STORE_STATUS_PORT=
# How long a ping is reused before another is sent.
STORE_STATUS_MS=30000

# Footer icons. "Label|url, Label|url" — the label picks the icon, so keep the
# network's name in it (Discord, YouTube, Twitter, TikTok, Instagram).
STORE_LINKS_SOCIAL=

# The public punishment list, read from SolarBans.
#
# A SEPARATE database with SEPARATE credentials, and they should carry SELECT
# on solarbans.punishments and nothing else — this service never writes to the
# punishment record. Leave blank and the page says it is not connected.
PUNISHMENTS_DB_HOST=
PUNISHMENTS_DB_PORT=3306
PUNISHMENTS_DB_USER=
PUNISHMENTS_DB_PASSWORD=
PUNISHMENTS_DB_NAME=solarbans

# Store funnel events mirrored to Beacon's dashboard.
#
# Fire and forget: nothing here is awaited and a Beacon that is down or
# unreachable costs the buyer nothing. Leave BEACON_URL blank and the mirror is
# simply off. The token is Beacon's BEACON_INGEST_TOKEN.
BEACON_URL=
BEACON_INGEST_TOKEN=

# ---------------------------------------------------------------------- demo
# true runs the whole site with nothing behind it: a sample catalogue, sample
# players, stats and punishments, baskets and sessions kept in memory, and a
# checkout page of its own that takes no money. No database, no Tebex token and
# no Minecraft server are needed. Never set it on a store taking real orders.
DEMO_MODE=false

# The folder of your own text (vote.json, terms.json, privacy.json, rules.json,
# store.json). Anything missing falls back to the templates in content.example/.
CONTENT_DIR=content
